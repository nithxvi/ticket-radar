{
  "name": "ticket-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "start": "node dist/cli.js watch",
    "watch": "node src/cli.ts watch",
    "once": "node src/cli.ts once",
    "doctor": "node src/cli.ts doctor",
    "seats": "node src/cli.ts seats",
    "notify-test": "node src/cli.ts notify-test",
    "build:web": "cd web && npm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/static": "^11.0.0",
    "fastify": "^5.12.8",
    "impit": "^0.14.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
