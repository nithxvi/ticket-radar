# ── Storage ────────────────────────────────────────────────────────────────
TICKET_RADAR_DB=./data/ticket-radar.db

# ── ntfy (https://ntfy.sh) ─────────────────────────────────────────────────
# Create/pick a topic, install the ntfy app, subscribe to it.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Optional, only for protected topics.
NTFY_TOKEN=

# ── Telegram ───────────────────────────────────────────────────────────────
# Talk to @BotFather to get a token, then message your bot and read
# https://api.telegram.org/bot<TOKEN>/getUpdates for the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
